import Alexander313.Carlson.OrdinalGenerationTransport
import Alexander313.Carlson.IsominimalCuts
import Alexander313.Carlson.ContinuityAnchors

/-!
# Correctness and generation of least ordinal copies

Carlson, *Patterns of resemblance of order 2*, Theorem 14.10(4--5),
printed pp. 67--68 of the October 16, 2008 manuscript:
https://people.math.osu.edu/carlson.6/research/patternstwofinal.pdf.

For both relation levels, every finite induced ordinal structure is a
k-correct extension of a least copy. A least copy also generates every
finite induced extension bounded by its old points. In the pure language
all points are indecomposable and all substructures are closed, so this
boundedness is precisely the source's condition on the largest
indecomposable, including the empty case.

The proof uses finite capture in an exact fair ordinal realization and
the fact that no first-relation edge leaves its initial segment. No
amalgamation theorem or comparison decision procedure is assumed.
-/

noncomputable section

namespace Alexander313.Carlson

namespace GeneratingSequence.OrdinalRealization

variable {α : Type*} [LinearOrder α] [Nonempty α]
variable {S : GeneratingSequence α} (R : GeneratingSequence.OrdinalRealization S)

/-- A finite set of ordinals inside the realized initial segment is
contained in the image of one actual finite stage. -/
theorem finite_capture (V : Finset Ordinal.{0}) (hV : ∀ z ∈ V, z < R.bound) :
    ∃ n, V ⊆ (R.stagePattern n).U := by
  classical
  let back (z : Ordinal.{0}) : α :=
    if hz : z < R.bound then (R.orderIso.symm ⟨z, hz⟩).val
    else Classical.choice inferInstance
  have hb (z : Ordinal.{0}) (hz : z < R.bound) : back z ∈ S.carrier := by
    simpa only [back, dif_pos hz] using (R.orderIso.symm ⟨z, hz⟩).property
  have he (z : Ordinal.{0}) (hz : z < R.bound) : R.label (back z) = z := by
    simp only [back, dif_pos hz]
    rw [R.label_eq (R.orderIso.symm ⟨z, hz⟩)]
    exact congrArg Subtype.val (R.orderIso.apply_symm_apply ⟨z, hz⟩)
  obtain ⟨n, hn⟩ := S.finite_capture (V.image back) (by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hx
    exact hb z (hV z hz))
  refine ⟨n, ?_⟩
  intro z hz
  rw [← he z (hV z hz)]
  exact Finset.mem_image_of_mem R.label (hn (Finset.mem_image_of_mem back hz))

/-- The actual ordinal images of any two stages retain their finite
generating derivation, even its auxiliary proof carriers. -/
theorem stage_exactlyGenerates {m n : ℕ} (hmn : m ≤ n) :
    Str.ExactlyGenerates (R.stagePattern m) (R.stagePattern n) :=
  (S.exactlyGenerates hmn).of_ordinal_isos (R.stage_isIso m) (R.stage_isIso n)
    (fun _ _ => rfl)

/-- The finite form of Theorem 14.10(5) inside a realized initial segment:
every induced finite extension of a stage is generated by that stage. -/
theorem stage_generates (n : ℕ) (V : Finset Ordinal.{0})
    (hV : ∀ z ∈ V, z < R.bound) (hbase : (R.stagePattern n).U ⊆ V) :
    Str.Generates (R.stagePattern n) (Str.ofOrdinals V) := by
  obtain ⟨m, hm⟩ := R.finite_capture V hV
  have hmn := (R.stage_exactlyGenerates (Nat.le_max_right n m)).isSub
  refine ⟨R.stagePattern (max n m), R.stage_exactlyGenerates (Nat.le_max_left n m),
    ⟨hm.trans hmn.1, fun _ _ _ _ => ⟨Iff.rfl, Iff.rfl⟩⟩, hbase⟩

/-- Theorem 14.10(4): both finite correctness conditions hold against
every induced finite ordinal ambient structure, even beyond the limit. -/
theorem stage_kCorrect (n : ℕ) (T : Finset Ordinal.{0}) (k : Lvl) :
    Str.KCorrect (R.stagePattern n) (Str.ofOrdinals T) k := by
  classical
  intro p x y _ _ hp hpy hxy
  have hpb : p < R.bound := by
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hp.1
    exact R.label_lt_bound (S.mem_carrier n ha)
  have hxb : x < R.bound := hp.2.1.trans_lt hpb
  have hab : R1 x y := by
    cases k
    · exact hxy
    · exact R2_R1 hxy
  have hyb : y < R.bound := R.lt_bound_of_R1 hxb hab
  let V := (R.stagePattern n).U ∪ {x, y}
  have hV : ∀ z ∈ V, z < R.bound := by
    intro z hz
    rcases Finset.mem_union.mp hz with hz | hz
    · obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hz
      exact R.label_lt_bound (S.mem_carrier n ha)
    · rcases Finset.mem_insert.mp hz with rfl | hz
      · exact hxb
      · rw [Finset.mem_singleton.mp hz]
        exact hyb
  have hc := (R.stage_generates n V hV Finset.subset_union_left).continuous
  exact hc.kcorrect k p x y
    (Finset.mem_union_right _ (Finset.mem_insert_self _ _))
    (Finset.mem_union_right _ (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))
    hp hpy hxy

end GeneratingSequence.OrdinalRealization

private theorem isominimal_seed_realization {U : Finset Ordinal.{0}}
    (hU : IsominimalOrdinalSet U) :
    ∃ (P : Str ℚ) (A : PatternRealization P),
      A.ordinal.stagePattern 0 = Str.ofOrdinals U := by
  classical
  let F := ordinalRationalRelabeling U
  let P := (Str.ofOrdinals U).map F.toFun
  have e := F.isIso (P := Str.ofOrdinals U) (Finset.Subset.refl U)
  have b := F.inverse_isIso (P := Str.ofOrdinals U) (Finset.Subset.refl U)
  let A := PatternRealization.ofPattern P (e.isPattern (Str.ofOrdinals_isPattern U))
  have hc : P.CoveringR F.invFun :=
    ⟨b.2.1, fun x hx y hy => (b.2.2 x hx y hy).1.mp,
      fun x hx y hy => (b.2.2 x hx y hy).2.mp⟩
  have hm : ∀ z ∈ U, A.label (F.toFun z) = z := by
    intro z hz
    have hle := A.seed_minimal hc (e.mem hz)
    rw [F.left_inv z hz] at hle
    have hk : (Str.ofOrdinals U).CoveringR (A.label ∘ F.toFun) :=
      ⟨fun x hx y hy hxy => A.seed_covering.1 _ (e.mem hx) _ (e.mem hy)
          (e.2.1 x hx y hy hxy),
        fun x hx y hy hxy => A.seed_covering.2.1 _ (e.mem hx) _ (e.mem hy)
          ((e.2.2 x hx y hy).1.mp hxy),
        fun x hx y hy hxy => A.seed_covering.2.2 _ (e.mem hx) _ (e.mem hy)
          ((e.2.2 x hx y hy).2.mp hxy)⟩
    exact hle.antisymm (hU.le_covering hk hz)
  have hcarrier : P.U.image A.label = U := by
    change (U.image F.toFun).image A.label = U
    rw [Finset.image_image]
    calc
      U.image (A.label ∘ F.toFun) = U.image id := Finset.image_congr hm
      _ = U := Finset.image_id
  refine ⟨P, A, ?_⟩
  simp only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed, hcarrier]

/-- Every finite isominimal induced ordinal structure is k-correct in
every finite induced ordinal ambient structure, for either relation level. -/
theorem IsominimalOrdinalSet.kCorrect {U : Finset Ordinal.{0}}
    (hU : IsominimalOrdinalSet U) (T : Finset Ordinal.{0}) (k : Lvl) :
    Str.KCorrect (Str.ofOrdinals U) (Str.ofOrdinals T) k := by
  obtain ⟨P, A, he⟩ := isominimal_seed_realization hU
  rw [← he]
  exact A.ordinal.stage_kCorrect 0 T k

/-- Theorem 14.10(5), pure case: an isominimal ordinal carrier generates
every induced finite extension bounded by its old points. -/
theorem IsominimalOrdinalSet.generates {U V : Finset Ordinal.{0}}
    (hU : IsominimalOrdinalSet U) (hUV : U ⊆ V)
    (hbounded : ∀ z ∈ V, ∃ p ∈ U, z ≤ p) :
    Str.Generates (Str.ofOrdinals U) (Str.ofOrdinals V) := by
  obtain ⟨P, A, he⟩ := isominimal_seed_realization hU
  have hbase : (A.ordinal.stagePattern 0).U ⊆ V := by
    simpa only [he, Str.ofOrdinals] using hUV
  have hV : ∀ z ∈ V, z < A.bound := by
    intro z hz
    obtain ⟨p, hp, hzp⟩ := hbounded z hz
    have hp' : p ∈ (A.ordinal.stagePattern 0).U := by
      simpa only [he, Str.ofOrdinals] using hp
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hp'
    exact hzp.trans_lt (A.ordinal.label_lt_bound (A.sequence.mem_carrier 0 ha))
  rw [← he]
  exact A.ordinal.stage_generates 0 V hV hbase

/-- For an isominimal source, the largest-point condition is also
necessary. This formulation handles the empty carrier without a maximum. -/
theorem IsominimalOrdinalSet.generates_iff {U V : Finset Ordinal.{0}}
    (hU : IsominimalOrdinalSet U) (hUV : U ⊆ V) :
    Str.Generates (Str.ofOrdinals U) (Str.ofOrdinals V) ↔
      ∀ z ∈ V, ∃ p ∈ U, z ≤ p :=
  ⟨fun d => d.continuous.2.1, hU.generates hUV⟩

/-- All five conclusions of Theorem 14.10 hold for every pure rational
pattern, with coveredness discharged by the unconditional covering theorem. -/
theorem exists_complete_minimal_ordinal_copy (P : Str ℚ) (hP : P.IsPattern) :
    ∃ h : ℚ → Ordinal.{0},
      Str.IsIso P (Str.ofOrdinals (P.U.image h)) h ∧
      (∀ g : ℚ → Ordinal.{0}, P.CoveringR g → ∀ x ∈ P.U, h x ≤ g x) ∧
      IsominimalOrdinalSet (P.U.image h) ∧
      (∀ (T : Finset Ordinal.{0}) (k : Lvl),
        Str.KCorrect (Str.ofOrdinals (P.U.image h)) (Str.ofOrdinals T) k) ∧
      (∀ V : Finset Ordinal.{0}, P.U.image h ⊆ V →
        (∀ z ∈ V, ∃ p ∈ P.U.image h, z ≤ p) →
        Str.Generates (Str.ofOrdinals (P.U.image h)) (Str.ofOrdinals V)) := by
  let A := PatternRealization.ofPattern P hP
  have hm : IsominimalOrdinalSet (P.U.image A.label) := by
    intro T f e hle
    simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed, Str.ofOrdinals] using
      A.ordinal.stage_isominimal 0
        (by simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed] using e)
        (by simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed,
          Str.ofOrdinals] using hle)
  exact ⟨A.label, A.seed_isIso, fun _ hg _ hx => A.seed_minimal hg hx, hm,
    hm.kCorrect, fun _ hUV hb => hm.generates hUV hb⟩

end Alexander313.Carlson
