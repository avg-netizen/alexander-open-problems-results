import Alexander313.Carlson.GeneratingRules
import Alexander313.Carlson.FiniteRelabeling

/-!
# Generating sequences and their union

Carlson, *Patterns of resemblance of order 2*, Definition 14.7 and
Lemma 14.8(1--2), pure case. Source:
https://people.math.osu.edu/carlson.6/research/patternstwofinal.pdf,
printed pp. 60--61 of the author's October 16, 2008 manuscript.

A generating sequence has one generating rule at each successor stage.
Its union is described by a carrier set and two relations, rather than
as a finite `Str`. Each relation witness includes membership of both
endpoints in a stage, so irrelevant off-carrier relation values do not
enter the union. The relations agree with every stage on its carrier.

Every finite subset of the union lies in one stage. Consequently every
finite induced substructure is a pattern, and every such substructure
containing a stage is generated by that stage. We also state the union's
reflection axioms, boundedness over each stage, and both correctness
conditions directly. These conclusions do not require fairness or a
covering of the initial pattern.
-/

noncomputable section

namespace Alexander313.Carlson

/-- The inclusion of a continuous subpattern is a continuous embedding.
This is the base embedding used when lifting an earlier sequence rule to
a later stage in Carlson's fairness condition. -/
theorem Str.Continuous.inclusionEmbedding {α : Type*} [LinearOrder α]
    {P Q : Str α} (h : Str.Continuous P Q) : Str.ContinuousEmbedding P Q id := by
  have e : Str.IsIso P (Q.restrict P.U) id := by
    refine ⟨by simp only [Finset.image_id, Str.restrict], ?_, ?_⟩
    · intro x hx y hy hxy
      exact hxy
    · intro x hx y hy
      exact h.1.2 x hx y hy
  unfold Str.ContinuousEmbedding
  rw [Finset.image_id]
  exact ⟨e, h.of_isIso e (Str.IsIso.refl Q) (fun _ _ => rfl)⟩

/-- A sequence with a generating rule at every successor step. Patternhood
and compatibility of the stages are consequences of the rule calculus. -/
structure GeneratingSequence (α : Type*) [LinearOrder α] where
  stage : ℕ → Str α
  step : ∀ n, Str.GeneratingRule (stage n) (stage (n + 1))

namespace GeneratingSequence

variable {α : Type*} [LinearOrder α] (S : GeneratingSequence α)

/-- Every stage is a pattern, including an empty initial stage. -/
theorem pattern (n : ℕ) : (S.stage n).IsPattern :=
  (S.step n).source_pattern

/-- Any interval of stages is a finite generating chain. -/
theorem exactlyGenerates {m n : ℕ} (h : m ≤ n) :
    Str.ExactlyGenerates (S.stage m) (S.stage n) := by
  induction n, h using Nat.le_induction with
  | base => exact .refl (S.pattern m)
  | succ n _ ih => exact .tail ih (S.step n)

theorem isSub {m n : ℕ} (h : m ≤ n) :
    Str.IsSub (S.stage m) (S.stage n) :=
  (S.exactlyGenerates h).isSub

theorem continuous {m n : ℕ} (h : m ≤ n) :
    Str.Continuous (S.stage m) (S.stage n) :=
  (S.exactlyGenerates h).continuous

theorem mem_mono {m n : ℕ} (h : m ≤ n) {x : α}
    (hx : x ∈ (S.stage m).U) : x ∈ (S.stage n).U :=
  (S.isSub h).1 hx

/-- The union of the finite stage carriers. -/
def carrier : Set α := {x | ∃ n, x ∈ (S.stage n).U}

/-- The limit carrier with the order inherited from the ambient order. -/
abbrev Limit := {x : α // x ∈ S.carrier}

theorem mem_carrier (n : ℕ) {x : α} (hx : x ∈ (S.stage n).U) :
    x ∈ S.carrier :=
  ⟨n, hx⟩

/-- Every finite subset of the union is contained in a single stage. -/
theorem finite_capture (F : Finset α) (hF : ∀ x ∈ F, x ∈ S.carrier) :
    ∃ n, F ⊆ (S.stage n).U := by
  classical
  revert hF
  induction F using Finset.induction_on with
  | empty =>
      intro _
      exact ⟨0, Finset.empty_subset _⟩
  | @insert a F ha ih =>
      intro hF
      obtain ⟨m, hm⟩ := hF a (Finset.mem_insert_self a F)
      obtain ⟨n, hn⟩ := ih (fun x hx => hF x (Finset.mem_insert_of_mem hx))
      refine ⟨max m n, Finset.insert_subset_iff.mpr ⟨?_, ?_⟩⟩
      · exact S.mem_mono (Nat.le_max_left m n) hm
      · exact hn.trans (S.isSub (Nat.le_max_right m n)).1

/-- Carrier-restricted union relations. In particular, off-carrier
relation values in individual stages create no edges in the union. -/
def rel (k : Lvl) (x y : α) : Prop :=
  ∃ n, x ∈ (S.stage n).U ∧ y ∈ (S.stage n).U ∧ (S.stage n).rel k x y

/-- The same union relations viewed on the limit subtype. -/
def limitRel (k : Lvl) (x y : S.Limit) : Prop := S.rel k x.val y.val

theorem rel_mem_left {k : Lvl} {x y : α} (h : S.rel k x y) : x ∈ S.carrier := by
  obtain ⟨n, hx, _, _⟩ := h
  exact S.mem_carrier n hx

theorem rel_mem_right {k : Lvl} {x y : α} (h : S.rel k x y) : y ∈ S.carrier := by
  obtain ⟨n, _, hy, _⟩ := h
  exact S.mem_carrier n hy

/-- The union agrees exactly with a stage on that stage's carrier. -/
theorem rel_iff (n : ℕ) {x y : α} (hx : x ∈ (S.stage n).U)
    (hy : y ∈ (S.stage n).U) (k : Lvl) :
    S.rel k x y ↔ (S.stage n).rel k x y := by
  constructor
  · rintro ⟨m, hxm, hym, hrel⟩
    have hm := S.isSub (Nat.le_max_left m n)
    have hn := S.isSub (Nat.le_max_right m n)
    exact (hn.rel_iff hx hy k).mpr ((hm.rel_iff hxm hym k).mp hrel)
  · intro hrel
    exact ⟨n, hx, hy, hrel⟩

/-- The finite induced structure on `F` using the union's relations. -/
def restrict (F : Finset α) : Str α := ⟨F, S.rel .one, S.rel .two⟩

theorem restrict_isSub {n : ℕ} {F : Finset α} (hF : F ⊆ (S.stage n).U) :
    Str.IsSub (S.restrict F) (S.stage n) := by
  refine ⟨hF, ?_⟩
  intro x hx y hy
  exact ⟨S.rel_iff n (hF hx) (hF hy) .one, S.rel_iff n (hF hx) (hF hy) .two⟩

theorem stage_isSub_restrict {n : ℕ} {F : Finset α} (hF : (S.stage n).U ⊆ F) :
    Str.IsSub (S.stage n) (S.restrict F) := by
  refine ⟨hF, ?_⟩
  intro x hx y hy
  exact ⟨(S.rel_iff n hx hy .one).symm, (S.rel_iff n hx hy .two).symm⟩

/-- Lemma 14.8(1), in the equivalent finite-restriction formulation for
the pure relational language. -/
theorem restrict_pattern (F : Finset α) (hF : ∀ x ∈ F, x ∈ S.carrier) :
    (S.restrict F).IsPattern := by
  obtain ⟨n, hn⟩ := S.finite_capture F hF
  exact (S.pattern n).mono (S.restrict_isSub hn)

/-- Every finite induced extension of a stage inside the union is
generated by that stage. The witness is a later stage containing it. -/
theorem generates_restrict (n : ℕ) (F : Finset α)
    (hF : ∀ x ∈ F, x ∈ S.carrier) (hbase : (S.stage n).U ⊆ F) :
    Str.Generates (S.stage n) (S.restrict F) := by
  obtain ⟨m, hm⟩ := S.finite_capture F hF
  have hcap : F ⊆ (S.stage (max n m)).U :=
    hm.trans (S.isSub (Nat.le_max_right n m)).1
  exact ⟨S.stage (max n m), S.exactlyGenerates (Nat.le_max_left n m),
    S.restrict_isSub hcap, hbase⟩

/-- Continuity over a stage for every finite induced extension inside
the union, as in Lemma 14.8(2). -/
theorem continuous_restrict (n : ℕ) (F : Finset α)
    (hF : ∀ x ∈ F, x ∈ S.carrier) (hbase : (S.stage n).U ⊆ F) :
    Str.Continuous (S.stage n) (S.restrict F) :=
  (S.generates_restrict n F hF hbase).continuous

/-- Each point of the union lies below an old point of any given stage.
In particular a sequence starting with the empty pattern stays empty. -/
theorem bounded (n : ℕ) {x : α} (hx : x ∈ S.carrier) :
    ∃ p ∈ (S.stage n).U, x ≤ p := by
  obtain ⟨m, hm⟩ := hx
  exact (S.continuous (Nat.le_max_left n m)).2.1 x
    (S.mem_mono (Nat.le_max_right n m) hm)

/-- Both correctness conditions extend from finite stages to the union.
The least-upper-bound witnesses continue to lie in the fixed base stage. -/
theorem kCorrect (n : ℕ) (k : Lvl) {p x y : α}
    (hp : Str.LeastGE (S.stage n).U x p) (hpy : p < y) (hxy : S.rel k x y) :
    ∃ p', Str.LeastGE (S.stage n).U y p' ∧ (S.stage n).rel k p p' := by
  obtain ⟨m, hx, hy, hrel⟩ := hxy
  have hs := S.isSub (Nat.le_max_right n m)
  have hc := S.continuous (Nat.le_max_left n m)
  have hrel' := (hs.rel_iff hx hy k).mp hrel
  cases k with
  | one => exact hc.2.2.1 p x y (hs.1 hx) (hs.1 hy) hp hpy hrel'
  | two => exact hc.2.2.2 p x y (hs.1 hx) (hs.1 hy) hp hpy hrel'

/-- Both union relations are contained in the ambient order. -/
theorem rel_le {k : Lvl} {x y : α} (h : S.rel k x y) : x ≤ y := by
  obtain ⟨n, hx, hy, hrel⟩ := h
  cases k with
  | one => exact (S.pattern n).le₁ x hx y hy hrel
  | two => exact (S.pattern n).le₁ x hx y hy ((S.pattern n).sub₂ x hx y hy hrel)

theorem rel_two_one {x y : α} (h : S.rel .two x y) : S.rel .one x y := by
  obtain ⟨n, hx, hy, hrel⟩ := h
  exact ⟨n, hx, hy, (S.pattern n).sub₂ x hx y hy hrel⟩

theorem rel_refl (k : Lvl) {x : α} (hx : x ∈ S.carrier) : S.rel k x x := by
  obtain ⟨n, hn⟩ := hx
  refine ⟨n, hn, hn, ?_⟩
  cases k with
  | one => exact (S.pattern n).refl₁ x hn
  | two => exact (S.pattern n).refl₂ x hn

theorem rel_trans {k : Lvl} {x y z : α} (hxy : S.rel k x y) (hyz : S.rel k y z) :
    S.rel k x z := by
  obtain ⟨m, hxm, hym, hxy⟩ := hxy
  obtain ⟨n, hyn, hzn, hyz⟩ := hyz
  have hm := S.isSub (Nat.le_max_left m n)
  have hn := S.isSub (Nat.le_max_right m n)
  have hxy' := (hm.rel_iff hxm hym k).mp hxy
  have hyz' := (hn.rel_iff hyn hzn k).mp hyz
  refine ⟨max m n, hm.1 hxm, hn.1 hzn, ?_⟩
  cases k with
  | one =>
      exact (S.pattern (max m n)).trans₁ x (hm.1 hxm) y (hm.1 hym) z
        (hn.1 hzn) hxy' hyz'
  | two =>
      exact (S.pattern (max m n)).trans₂ x (hm.1 hxm) y (hm.1 hym) z
        (hn.1 hzn) hxy' hyz'

theorem rel_convex_one {x y z : α} (hy : y ∈ S.carrier) (hxy : x ≤ y)
    (hyz : y ≤ z) (hxz : S.rel .one x z) : S.rel .one x y := by
  obtain ⟨m, hxm, hzm, hxz⟩ := hxz
  obtain ⟨n, hyn⟩ := hy
  have hm := S.isSub (Nat.le_max_left m n)
  have hn := S.isSub (Nat.le_max_right m n)
  refine ⟨max m n, hm.1 hxm, hn.1 hyn, ?_⟩
  exact (S.pattern (max m n)).convex₁ x (hm.1 hxm) y (hn.1 hyn) z (hm.1 hzm)
    hxy hyz ((hm.rel_iff hxm hzm .one).mp hxz)

theorem rel_respect_two {x y z : α} (hxy : x ≤ y) (hyz : y ≤ z)
    (hxz : S.rel .two x z) (hyz' : S.rel .one y z) : S.rel .two x y := by
  obtain ⟨m, hxm, hzm, hxz⟩ := hxz
  obtain ⟨n, hyn, hzn, hyz'⟩ := hyz'
  have hm := S.isSub (Nat.le_max_left m n)
  have hn := S.isSub (Nat.le_max_right m n)
  refine ⟨max m n, hm.1 hxm, hn.1 hyn, ?_⟩
  exact (S.pattern (max m n)).respect₂ x (hm.1 hxm) y (hn.1 hyn) z (hm.1 hzm)
    hxy hyz ((hm.rel_iff hxm hzm .two).mp hxz) ((hn.rel_iff hyn hzn .one).mp hyz')

end GeneratingSequence
end Alexander313.Carlson
