import Alexander313.Carlson.FiniteIsomorphism
import Alexander313.Carlson.LeastCopyAgreement
import Alexander313.Carlson.IsominimalCuts

/-!
# Least ordinal copies preserve exact subpatterns

The initial span of an exact subpattern becomes a downward closed,
1-correct subcarrier of the least target copy. Carlson's Lemma 15.7
makes that span isominimal. Its least labels therefore coincide with
the target labels, and agreement along the generated source-to-span
rule identifies the source labels. This is the ingredient in the proof
of Theorem 15.9(2); neither uniqueness nor pointed comparison is assumed.
-/

noncomputable section

namespace Alexander313.Carlson

namespace PatternRealization

variable {P : Str ℚ} (A : PatternRealization P)

/-- Every actual least realization has an isominimal seed image. -/
theorem image_isominimal : IsominimalOrdinalSet (P.U.image A.label) := by
  intro T f e hle
  simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed,
    Str.ofOrdinals] using
    A.ordinal.stage_isominimal 0
      (by simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed,
        Str.ofOrdinals] using e)
      (by simpa only [GeneratingSequence.OrdinalRealization.stagePattern, A.seed,
        Str.ofOrdinals] using hle)

/-- A least realization agrees pointwise with any isominimal ordinal copy.
The inverse is used only on the finite carrier, including the empty case. -/
theorem label_eq_of_isominimal_copy {U : Finset Ordinal.{0}}
    {f : ℚ → Ordinal.{0}} (e : Str.IsIso P (Str.ofOrdinals U) f)
    (hU : IsominimalOrdinalSet U) : ∀ x ∈ P.U, A.label x = f x := by
  obtain ⟨g, eg, hleft, _⟩ := e.exists_inverse
  have ef : P.CoveringR f :=
    ⟨e.2.1, fun x hx y hy => (e.2.2 x hx y hy).1.mp,
      fun x hx y hy => (e.2.2 x hx y hy).2.mp⟩
  have ec := A.seed_isIso.comp eg
  have hc : (Str.ofOrdinals U).CoveringR (A.label ∘ g) :=
    ⟨ec.2.1, fun x hx y hy => (ec.2.2 x hx y hy).1.mp,
      fun x hx y hy => (ec.2.2 x hx y hy).2.mp⟩
  intro x hx
  have hback := hU.le_covering hc (e.mem hx)
  simp only [Function.comp_apply, hleft x hx] at hback
  exact (A.seed_minimal ef hx).antisymm hback

end PatternRealization

namespace Str

/-- The least target image of the initial span of an exact subpattern
is itself isominimal. The whole target need not be generated by the source. -/
theorem Exact.initialSpan_image_isominimal {P Q : Str ℚ}
    (d : Exact P Q) (B : PatternRealization Q) :
    IsominimalOrdinalSet ((Q.initialSpan P.U).U.image B.label) := by
  let S := Q.initialSpan P.U
  let U := S.U.image B.label
  let V := Q.U.image B.label
  have e := B.seed_isIso
  have hSQ : IsSub S Q := Q.initialSpan_isSub P.U
  have hUV : U ⊆ V := Finset.image_subset_image hSQ.1
  have hlower : ∀ x ∈ V, ∀ y ∈ U, x ≤ y → x ∈ U := by
    intro x hx y hy hxy
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hy
    obtain ⟨_, p, hp, hbp⟩ := mem_initialSpan.mp hb
    have hab : a ≤ b := (e.le_iff ha (hSQ.1 hb)).mp hxy
    exact Finset.mem_image_of_mem B.label (mem_initialSpan.mpr ⟨ha, p, hp, hab.trans hbp⟩)
  have hclosed : ∀ x ∈ U, ∀ y ∈ V, R1 x y → y ∈ U := by
    intro x hx y hy hxy
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hy
    have hab : Q.r₁ a b := (e.2.2 a (hSQ.1 ha) b hb).1.mpr hxy
    have hbS := (initialSpan_correct_iff Q P.U).mp d.correct a ha b hb hab
    exact Finset.mem_image_of_mem B.label hbS
  have hc : KCorrect (ofOrdinals U) (ofOrdinals V) .one :=
    (kCorrect_one_iff_no_crossing hUV hlower).mpr hclosed
  exact B.image_isominimal.of_initial_correct hUV hlower hc

/-- Exact rational subpatterns retain their least ordinal labels. -/
theorem Exact.least_copy_agrees {P Q : Str ℚ} (d : Exact P Q)
    (A : PatternRealization P) (B : PatternRealization Q) :
    ∀ x ∈ P.U, B.label x = A.label x := by
  let S := Q.initialSpan P.U
  let C := PatternRealization.ofPattern S d.generates.target_pattern
  have hSQ : IsSub S Q := Q.initialSpan_isSub P.U
  have eS : IsIso S (ofOrdinals (S.U.image B.label)) B.label :=
    ⟨rfl, fun x hx y hy => B.seed_isIso.2.1 x (hSQ.1 hx) y (hSQ.1 hy),
      fun x hx y hy => B.seed_isIso.2.2 x (hSQ.1 hx) y (hSQ.1 hy)⟩
  have hlabels := C.label_eq_of_isominimal_copy eS (d.initialSpan_image_isominimal B)
  have hagree := d.generates.valid.least_copy_agrees A C
  intro x hx
  exact (hlabels x (d.generates.isSub.1 hx)).symm.trans (hagree x hx)

/-- Exact embeddings commute with actual least ordinal realizations.
This conclusion names the given map, so it applies to each amalgamation image. -/
theorem IsIso.exact_least_copy_agrees {P Q : Str ℚ} {f : ℚ → ℚ}
    (e : IsIso P (Q.restrict (P.U.image f)) f)
    (hxExact : Exact (Q.restrict (P.U.image f)) Q)
    (A : PatternRealization P) (B : PatternRealization Q) :
    ∀ x ∈ P.U, B.label (f x) = A.label x := by
  let I := Q.restrict (P.U.image f)
  let C := PatternRealization.ofPattern I hxExact.source_pattern
  have ec := C.seed_isIso.comp e
  have hlabels := A.label_eq_of_isominimal_copy ec C.image_isominimal
  intro x hx
  exact (hxExact.least_copy_agrees C B (f x) (e.mem hx)).trans (hlabels x hx).symm

end Str
end Alexander313.Carlson
